# ==========================================
# ULTRON DESKTOP ASSISTANT CONFIGURATION
# ==========================================

# LLM Brain Provider: "groq" (recommended for speed), "openai", "anthropic", or "gemini"
LLM_PROVIDER=groq

# Primary LLM API Keys (fill at least ONE):
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Specific Models (optional overrides):
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-2.0-flash

# Voice & Speech Settings:
# TTS Voices: "en-IN-PrabhatNeural" (Indian Male), "en-IN-NeerjaNeural" (Indian Female),
#             "en-US-GuyNeural" (American Male), "hi-IN-MadhurNeural" (Hindi Male)
TTS_VOICE=en-IN-PrabhatNeural
TTS_RATE=+5%
TTS_VOLUME=+0%
VOICE_INPUT_ENABLED=true
VOICE_OUTPUT_ENABLED=true
WAKE_WORD=hey ultron

# Safety Settings:
REQUIRE_CONFIRMATION_FOR_DANGEROUS=true
MAX_COMMAND_TIMEOUT_SECONDS=60

# VPN Settings:
# Supported: "windows_rasdial", "protonvpn", "nordvpn", "wireguard", "custom"
VPN_TYPE=windows_rasdial
VPN_CONNECTION_NAME=MyVPN
VPN_CLI_PATH=

# External API Integrations (Optional):
# Google Workspace
GMAIL_CLIENT_SECRET_FILE=
# Meta / Facebook & Instagram Marketing API
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# Twilio / Exotel
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
